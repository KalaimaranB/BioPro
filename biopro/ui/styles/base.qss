/* 
    Master Global Stylesheet for BioPro
    Variables like {BG_DARKEST} will be substituted dynamically by ThemeManager
*/

/* --- GLOBAL APP BACKGROUND --- */
* {
    font-family: Arial, sans-serif;
}

QMainWindow, QDialog, QScrollArea {
    background-color: {BG_DARKEST};
    color: {FG_PRIMARY};
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* --- BUTTONS --- */
QPushButton#PrimaryButton, QPushButton[variant="primary"] {
    background-color: {ACCENT_PRIMARY};
    color: {BG_DARKEST};
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#PrimaryButton:hover, QPushButton[variant="primary"]:hover {
    background-color: {ACCENT_PRIMARY_HOVER};
}
QPushButton#PrimaryButton:disabled, QPushButton[variant="primary"]:disabled {
    background-color: {BG_MEDIUM};
    color: {FG_SECONDARY};
}

QPushButton#SecondaryButton, QPushButton[variant="secondary"] {
    background-color: {BG_MEDIUM};
    color: {FG_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 13px;
}
QPushButton#SecondaryButton:hover, QPushButton[variant="secondary"]:hover {
    background-color: {BG_LIGHT};
    border-color: {FG_SECONDARY};
}

QPushButton#DangerButton, QPushButton[variant="danger"] {
    background-color: {ACCENT_DANGER};
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#DangerButton:hover, QPushButton[variant="danger"]:hover {
    background-color: {ACCENT_CRITICAL};
}

QPushButton#BioToggleButton {
    background-color: {BG_MEDIUM};
    color: {FG_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton#BioToggleButton:checked {
    background-color: {ACCENT_PRIMARY};
    color: {BG_DARKEST};
    border: 1px solid {ACCENT_PRIMARY};
}
QPushButton#BioToggleButton:hover {
    border-color: {BORDER_FOCUS};
}

/* --- CARDS & PANELS --- */
QFrame#BioCard, QFrame[variant="card"] {
    background-color: {BG_DARK};
    border: 1px solid {BORDER};
    border-radius: 10px;
}
QFrame#BioCard:hover {
    border: 1px solid {ACCENT_PRIMARY};
    background-color: {BG_MEDIUM};
}

QFrame#LeftPanel {
    background-color: {BG_DARK};
    border-right: 1px solid {BORDER};
}

/* --- TEXT & TYPOGRAPHY --- */
QLabel#HeaderLabel {
    font-size: 18px;
    font-weight: bold;
    color: {FG_PRIMARY};
}
QLabel#TitleLabel {
    font-size: 28px;
    font-weight: bold;
    color: {FG_PRIMARY};
}
QLabel#SubtitleLabel {
    font-size: 16px;
    color: {FG_SECONDARY};
}
QLabel#DescriptionLabel {
    font-size: 13px;
    color: {FG_SECONDARY};
}
QLabel#SmallCaption {
    font-size: 12px;
    color: {FG_SECONDARY};
}
QLabel#BadgeSuccess {
    color: {ACCENT_SUCCESS};
    font-weight: bold;
}
QLabel#BadgeWarning {
    color: {ACCENT_WARNING};
    font-weight: bold;
}

/* --- MISC --- */
QFrame#HorizontalSeparator {
    background-color: {BORDER};
    margin: 10px 0px;
}

/* --- ACADEMY DASHBOARD SPECIFICS --- */
QFrame#BadgeCardEarned {
    background-color: {BG_DARK};
    border: 1px solid {BORDER};
    border-radius: 8px;
    border-bottom: 3px solid {ACCENT_WARNING};
}
QFrame#BadgeCardLocked {
    background-color: {BG_DARKEST};
    border: 1px dashed {BORDER};
    border-radius: 8px;
}
QLabel#BadgeIconEarned {
    font-size: 32px;
    color: {FG_PRIMARY};
}
QLabel#BadgeIconLocked {
    font-size: 32px;
    color: {FG_DISABLED};
}
QProgressBar#AcademyProgressBar {
    background-color: {BG_DARKEST};
    border-radius: 3px;
}
QProgressBar#AcademyProgressBar::chunk {
    background-color: {ACCENT_SUCCESS};
    border-radius: 3px;
}
QScrollArea#TransparentScroll, QWidget#TransparentContainer, QWidget#DashboardMain {
    background-color: transparent;
    border: none;
}

/* --- PROJECT LAUNCHER --- */
QWidget#LauncherLeftPanel {
    background-color: {BG_DARK};
    border-right: 1px solid {BORDER};
}
QLabel#LauncherRecentLabel {
    color: {FG_PRIMARY};
    font-size: 14px;
    font-weight: bold;
    border: none;
}
QListWidget#LauncherRecentList {
    border: none;
    outline: none;
    background: transparent;
    color: {FG_SECONDARY};
}
QListWidget#LauncherRecentList::item {
    padding: 10px;
    border-radius: 5px;
}
QListWidget#LauncherRecentList::item:hover {
    background: {BG_MEDIUM};
}
QListWidget#LauncherRecentList::item:selected {
    background: {ACCENT_PRIMARY};
    color: {BG_DARKEST};
    font-weight: bold;
}
QLabel#LauncherTitle {
    color: {FG_PRIMARY};
    font-weight: 900;
    letter-spacing: 1px;
}
QLabel#LauncherBadge {
    color: {ACCENT_PRIMARY};
    background: transparent;
    border: 1px solid {ACCENT_PRIMARY};
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: bold;
    margin-top: 15px;
}
QLabel#LauncherSubtitle {
    color: {FG_PRIMARY};
    font-weight: bold;
}
QLabel#LauncherDesc {
    color: {FG_SECONDARY};
    margin-bottom: 20px;
}

/* --- COURSE COMPLETE OVERLAY --- */
QFrame#CompleteCard {
    background-color: {BG_DARK};
    border: 1px solid {ACCENT_PRIMARY};
    border-radius: 12px;
}
QLabel#CourseCompleteTitle {
    font-size: 24px; /* SIZE_LARGE placeholder */
    font-weight: 800;
    letter-spacing: 2px;
    color: {ACCENT_PRIMARY};
}
QLabel#CourseCompleteMessage {
    font-size: 14px; /* SIZE_NORMAL placeholder */
    color: {FG_PRIMARY};
    line-height: 1.4;
}
QLabel#CourseCompleteCertLabel {
    font-size: 10px;
    font-weight: bold;
    color: {FG_SECONDARY};
    letter-spacing: 1px;
}
QLabel#CourseCompleteBadgeLabel {
    font-size: 14px; /* SIZE_NORMAL placeholder */
    font-weight: bold;
    color: {FG_PRIMARY};
    background-color: {BG_DARKEST};
    padding: 8px 16px;
    border-radius: 4px;
    border: 1px solid {BORDER};
}
QPushButton#CourseCompleteBtn {
    background-color: transparent;
    color: {ACCENT_PRIMARY};
    border: 2px solid {ACCENT_PRIMARY};
    border-radius: 4px;
    padding: 12px 24px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}
QPushButton#CourseCompleteBtn:hover {
    background-color: {ACCENT_PRIMARY};
    color: {BG_DARKEST};
}
QPushButton#CourseCompleteBtn:pressed {
    background-color: {ACCENT_PRIMARY};
    border-color: {ACCENT_PRIMARY};
}

/* --- WORKSPACE WINDOW --- */
QWidget#WorkspaceAnalysisPage {
    background-color: {BG_DARKEST};
}
QLabel#AurebeshLabel {
    color: {ACCENT_PRIMARY};
    font-size: 9px;
    padding-bottom: 2px;
    background: {BG_DARK};
    border-bottom: 1px solid {BORDER};
}
QStatusBar#WorkspaceStatusBar {
    background: {BG_DARK};
    color: {FG_SECONDARY};
    border-top: 1px solid {BORDER};
}
QLabel#CopyrightLabel {
    color: {FG_SECONDARY};
    padding-right: 15px;
}

/* --- TRUST DIALOG --- */
QLabel#TrustHeader {
    font-size: 20px;
    font-weight: 800;
    color: {ACCENT_PRIMARY};
    margin-bottom: 4px;
}
QLabel#TrustSub {
    color: {FG_SECONDARY};
    font-size: 12px;
    margin-bottom: 24px;
}
QLabel#TrustIcon {
    border-radius: 16px;
    font-size: 16px;
    color: {BG_DARKEST};
}
QFrame#TrustLine {
    background: {BORDER};
    margin-left: 15px;
    margin-right: 15px;
}
QLabel#TrustName {
    font-weight: 700;
    font-size: 14px;
    color: {FG_PRIMARY};
}
QLabel#TrustStatus {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
}
QLabel#TrustKey {
    font-size: 10px;
    color: {FG_SECONDARY};
}
